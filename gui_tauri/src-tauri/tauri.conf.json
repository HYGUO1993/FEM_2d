{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FemLab Studio",
  "version": "0.3.1",
  "identifier": "com.femlab.studio",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FemLab Studio - 二维杆系有限元分析",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http: https: data: blob: ipc:http://tauri.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../build/bin/femcli.exe": "femcli.exe"
    }
  }
}
